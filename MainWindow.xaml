<Window x:Class="mono.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:mono.Converters"
        xmlns:views="clr-namespace:mono.Views"
        xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Lucide"
        Title="mono" Width="440" MinWidth="330"
        SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="False"
        Background="{StaticResource Background}"
        BorderBrush="#000000" BorderThickness="0.8"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        Margin="0" Padding="0">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="4"
                      GlassFrameThickness="0"
                      NonClientFrameEdges="None"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="TransportButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontInter}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceAlt}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceAlt}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatSlider" TargetType="Slider">
            <Setter Property="Height" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Height="3" VerticalAlignment="Center"
                                    Background="{StaticResource Border}" CornerRadius="1.5"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="{StaticResource Accent}" Height="3" CornerRadius="1.5"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="10" Height="10"
                                                         Fill="{StaticResource Accent}"
                                                         Stroke="{StaticResource Border}" StrokeThickness="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource Background}" Margin="0" Padding="0"
            TextElement.FontFamily="{StaticResource FontInter}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="56"/>
                    <RowDefinition Height="44"/>
                </Grid.RowDefinitions>

                <!-- ROW A — Title bar -->
                <Border Grid.Row="0" Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="Border_MouseLeftButtonDown">
                    <Grid>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="10,0,0,0"
                                    HorizontalAlignment="Left">
                            <iconPacks:PackIconLucide
                                Kind="AudioWaveform"
                                Width="13" Height="13"
                                Foreground="{StaticResource TextPrimary}"
                                VerticalAlignment="Center"
                                Margin="0,0,5,0"/>
                            <TextBlock
                                FontFamily="{StaticResource FontDMSans}"
                                FontWeight="SemiBold"
                                FontStyle="Normal"
                                FontSize="13"
                                Foreground="{StaticResource TextPrimary}"
                                VerticalAlignment="Center"
                                Text="mono"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Stretch">
                        <Button x:Name="MinimizeButton"
                                Width="32" Height="28"
                                Padding="0"
                                VerticalAlignment="Stretch"
                                Background="Transparent"
                                Margin="-8,0,0,0"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="MinimizeButton_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd"
                                                            Background="{TemplateBinding Background}"
                                                            Width="24" Height="28">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Foreground"
                                                                    Value="#7c3aed"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter Property="Foreground"
                                                                    Value="#6d28d9"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <iconPacks:PackIconLucide Kind="Minus" Width="12" Height="12"/>
                            </Button>
                            <Button x:Name="CloseButton"
                                    Width="32" Height="28"
                                    Padding="0"
                                    VerticalAlignment="Stretch"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="CloseButton_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd"
                                                            Background="{TemplateBinding Background}"
                                                            Width="32" Height="28">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Foreground"
                                                                    Value="#7c3aed"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter Property="Foreground"
                                                                    Value="#6d28d9"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <iconPacks:PackIconLucide Kind="X" Width="12" Height="12"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ROW B — Track info + cover art -->
                <Grid Grid.Row="1" Background="{StaticResource Surface}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="10,0,8,0">
                        <TextBlock x:Name="TrackTitleText"
                                   FontSize="13" FontWeight="Medium"
                                   Foreground="{StaticResource TextPrimary}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="Wrap">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource TitleDisplayConverter}">
                                    <Binding Path="CurrentTrack.Artist" FallbackValue=""/>
                                    <Binding Path="CurrentTrack.Title" FallbackValue=""/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Border Background="{StaticResource SurfaceAlt}" CornerRadius="3"
                                    BorderBrush="{StaticResource Border}" BorderThickness="1"
                                    Padding="5,1"
                                    Margin="0,0,4,0"
                                    Visibility="{Binding CurrentTrack.Format,
                                        Converter={StaticResource StringToVisibilityConverter},
                                        FallbackValue=Collapsed,
                                        TargetNullValue=Collapsed}">
                                <TextBlock FontFamily="{StaticResource FontInter}" FontSize="10"
                                           Foreground="{StaticResource TextSecondary}">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource FormatBadgeConverter}">
                                            <Binding Path="CurrentTrack.Format" FallbackValue=""/>
                                            <Binding Path="CurrentTrack.SampleRate" Converter="{StaticResource SampleRateConverter}" FallbackValue=""/>
                                            <Binding Path="CurrentTrack.BitDepth" FallbackValue="0"/>
                                            <Binding Path="CurrentTrack.Bitrate" FallbackValue="0"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Border>
                            <Border x:Name="AnalysisBadgeContainer"
                                    Background="{StaticResource SurfaceAlt}"
                                    CornerRadius="3"
                                    BorderBrush="{StaticResource Border}"
                                    BorderThickness="1"
                                    Padding="5,1"
                                    Visibility="{Binding AnalysisBadge,
                                        Converter={StaticResource StringToVisibilityConverter}}">
                                <TextBlock
                                    FontFamily="{StaticResource FontInter}"
                                    FontSize="10"
                                    Foreground="{StaticResource TextSecondary}"
                                    Text="{Binding AnalysisBadge}"
                                    ToolTip="BPM · Musical Key · Integrated LUFS"/>
                            </Border>
                        </WrapPanel>
                    </StackPanel>

                    <Image Grid.Column="1"
                           Source="{Binding CoverArtSource}"
                           Width="80" Height="80"
                           Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Stretch"
                           Visibility="{Binding CoverArtVisibility}"/>
                </Grid>

                <!-- ROW C — Waveform -->
                <Border Grid.Row="2" Background="{StaticResource SurfaceAlt}"
                        BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,1">
                    <views:WaveformView DataContext="{Binding WaveformVM}"/>
                </Border>

                <!-- ROW D — Transport controls -->
                <Border Grid.Row="3" Background="{StaticResource Background}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PositionDisplay}"
                                   FontFamily="Consolas" FontSize="11"
                                   Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center" Margin="8,0,36,0"/>

                        <Button x:Name="PlaylistButton" Width="32" Height="32"
                                Style="{StaticResource TransportButtonStyle}"
                                Margin="0,0,6,0"
                                Click="PlaylistButton_Click">
                            <Grid>
                                <iconPacks:PackIconLucide Kind="List" Width="15" Height="15"/>
                                <Border x:Name="PlaylistBadge"
                                        Visibility="Collapsed"
                                        Background="#1c1c1c"
                                        CornerRadius="6"
                                        MinWidth="12"
                                        Height="12"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,-4,-4,0"
                                        Padding="2,0">
                                    <TextBlock x:Name="PlaylistBadgeText"
                                               Text="0"
                                               FontFamily="{StaticResource FontInter}"
                                               FontSize="8"
                                               FontWeight="Medium"
                                               Foreground="#ffffff"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Button>

                        <Button Command="{Binding PrevCommand}"
                                Style="{StaticResource TransportButtonStyle}">
                            <iconPacks:PackIconLucide Kind="SkipBack" Width="15" Height="15"/>
                        </Button>

                        <Button x:Name="PlayPauseButton"
                                Style="{StaticResource TransportButtonStyle}"
                                Width="36" Height="36"
                                Command="{Binding PlayPauseCommand}"
                                Margin="2,0">
                            <iconPacks:PackIconLucide x:Name="PlayPauseIcon"
                                Kind="Play" Width="15" Height="15"/>
                        </Button>

                        <Button Command="{Binding StopCommand}"
                                Style="{StaticResource TransportButtonStyle}">
                            <iconPacks:PackIconLucide Kind="Square" Width="15" Height="15"/>
                        </Button>
                        <Button Command="{Binding NextCommand}"
                                Style="{StaticResource TransportButtonStyle}">
                            <iconPacks:PackIconLucide Kind="SkipForward" Width="15" Height="15"/>
                        </Button>

                        <Button x:Name="MuteButton"
                                Width="20" Height="20"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Padding="0"
                                Margin="8,0,4,0"
                                VerticalAlignment="Center"
                                Click="MuteButton_Click"
                                ToolTip="Mute">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <iconPacks:PackIconLucide x:Name="VolumeIcon"
                                                      Kind="Volume2"
                                                      Width="13" Height="13"
                                                      Foreground="{StaticResource TextSecondary}"/>
                        </Button>
                        <Border Width="64" Height="20"
                                Background="Transparent"
                                VerticalAlignment="Center"
                                PreviewMouseLeftButtonDown="VolumeSlider_PreviewMouseDown">
                            <Slider x:Name="VolumeSlider"
                                    Width="64"
                                    Minimum="0" Maximum="1" Value="1"
                                    Style="{StaticResource FlatSlider}"
                                    VerticalAlignment="Center"
                                    ValueChanged="VolumeSlider_ValueChanged"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <views:PlaylistDock x:Name="PlaylistDockView" Grid.Row="1"
                                Visibility="Collapsed"/>
        </Grid>
    </Border>
</Window>
